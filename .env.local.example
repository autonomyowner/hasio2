# Convex Backend
EXPO_PUBLIC_CONVEX_URL=https://your-project.convex.cloud
EXPO_PUBLIC_CONVEX_SITE_URL=https://your-project.convex.site

# Cloudflare R2 Storage
EXPO_PUBLIC_R2_PUBLIC_URL=https://pub-xxx.r2.dev

# AI Services (optional)
EXPO_PUBLIC_GROQ_API_KEY=...
EXPO_PUBLIC_OPENAI_API_KEY=...
EXPO_PUBLIC_ELEVENLABS_API_KEY=...

# NOTE: Set these in Convex dashboard (npx convex env set):
# BETTER_AUTH_SECRET=<generate with: openssl rand -base64 32>
# SITE_URL=http://localhost:8081  (or your production app URL)
